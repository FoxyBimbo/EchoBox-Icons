<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="EchoBox.App.Views.IconPickerFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EchoBox.Core.Models"
    Title="Select Icons"
    PrimaryButtonText="Confirm Selection"
    CloseButtonText="Cancel">

    <Grid Width="500" Height="400" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" PlaceholderText="Search icon library..." TextChanged="SearchBox_TextChanged" />
        </Grid>

        <ListView
            x:Name="IconListView"
            Grid.Row="1"
            SelectionMode="Multiple"
            SelectionChanged="IconListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:IconItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="8,4" CornerRadius="4">
                        <Image Grid.Column="0" Width="32" Height="32" Source="{x:Bind FilePath, Mode=OneTime}" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind RelativePath, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="SelectionCountTextBlock" Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</ContentDialog>
