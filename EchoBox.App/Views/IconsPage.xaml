<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EchoBox.App.Views.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:EchoBox.App.Helpers"
    xmlns:models="using:EchoBox.Core.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="GridViewHeaderItemDividerStroke" Color="Transparent" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:FilePathToThumbnailConverter x:Key="FilePathToThumbnailConverter" />
        <CollectionViewSource x:Name="GroupedCategoryCvs" IsSourceGrouped="True" ItemsPath="Icons" />
    </Page.Resources>

    <Grid>
        <GridView x:Name="CategoryGridView"
                  ItemsSource="{x:Bind GroupedCategoryCvs.View, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="8,8,16,24">

            <GridView.Header>
                <StackPanel Spacing="16" Margin="0,0,0,16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Icons Library &amp; Category Manager" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Import Images / Icons" Style="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ImportIconsButton" Content="Import Files..." Style="{StaticResource AccentButtonStyle}" Click="ImportIconsButton_Click" />
                                <Button x:Name="ImportFolderButton" Content="Import Folder..." Style="{StaticResource AccentButtonStyle}" Click="ImportFolderButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                        <ComboBox x:Name="CategoryFilterComboBox" Grid.Column="0" PlaceholderText="Filter by Category" DisplayMemberPath="Name" SelectionChanged="CategoryFilterComboBox_SelectionChanged" MinWidth="180" />
                        <Button x:Name="ManageCategoriesButton" Grid.Column="1" Click="ManageCategoriesButton_Click" ToolTipService.ToolTip="Manage Categories" Padding="8,6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                        </Button>
                        <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search icons by name..." TextChanged="SearchBox_TextChanged" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </GridView.Header>

            <GridView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="GridViewHeaderItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewHeaderItem">
                                        <ContentPresenter x:Name="ContentPresenter"
                                                          Margin="{TemplateBinding Padding}"
                                                          Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="models:IconCategoryGroup">
                            <Grid Padding="0,12,0,8">
                                <Button Click="CategoryHeader_Click" Tag="{x:Bind Mode=OneTime}"
                                        Background="Transparent" BorderThickness="0" Padding="4,4,8,4"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                        CornerRadius="4" ToolTipService.ToolTip="Click to expand/collapse category">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind IconCountText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </GridView.GroupStyle>

            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:IconItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Width="105" Height="135" Margin="0,0,8,8">
                        <Grid RowDefinitions="*,Auto,Auto,Auto">
                            <Image Grid.Row="0" Width="44" Height="44" Source="{x:Bind FilePath, Mode=OneTime, Converter={StaticResource FilePathToThumbnailConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{x:Bind Name, Mode=OneTime}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,1" />
                            <TextBlock Grid.Row="2" Text="{x:Bind DisplayCategoryName, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="9.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                <Button ToolTipService.ToolTip="Edit" Padding="4,2" Click="EditIcon_Click" Tag="{x:Bind Mode=OneTime}">
                                    <FontIcon Glyph="&#xE70F;" FontSize="10" />
                                </Button>
                                <Button ToolTipService.ToolTip="Delete" Padding="4,2" Click="DeleteIcon_Click" Tag="{x:Bind Mode=OneTime}" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                    <FontIcon Glyph="&#xE74D;" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>

