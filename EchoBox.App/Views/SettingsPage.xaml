<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EchoBox.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="12,8,12,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="LayoutVisualStateGroup">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1000" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MainStackPanel.(Grid.Column)" Value="1" />
                            <Setter Target="MainStackPanel.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MainStackPanel.(Grid.Column)" Value="0" />
                            <Setter Target="MainStackPanel.(Grid.ColumnSpan)" Value="3" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel x:Name="MainStackPanel" Grid.Column="1" Grid.ColumnSpan="1" Spacing="24" HorizontalAlignment="Stretch">

                <StackPanel Spacing="4">
                    <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0" Text="Windows Explorer Right-Click Integration" Style="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                        <ToggleSwitch x:Name="ContextMenuToggle" Grid.Column="1" Toggled="ContextMenuToggle_Toggled" OnContent="Enabled" OffContent="Disabled" />
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Engine Performance &amp; Threading" Style="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Slider x:Name="ThreadsSlider" Minimum="1" Maximum="32" StepFrequency="1" ValueChanged="ThreadsSlider_ValueChanged" />
                            <TextBlock x:Name="ThreadsValueTextBlock" Grid.Column="1" Text="8 Threads" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="System Safety &amp; Custom Exclusions" Style="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox x:Name="NewExclusionTextBox" PlaceholderText="Enter custom path exclusion..." />
                            <Button x:Name="BrowseExclusionButton" Grid.Column="1" Content="Browse..." Click="BrowseExclusionButton_Click" />
                            <Button x:Name="AddExclusionButton" Grid.Column="2" Content="Add Exclusion" Style="{StaticResource AccentButtonStyle}" Click="AddExclusionButton_Click" />
                        </Grid>

                        <ListView x:Name="ExclusionsListView" Height="150" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Padding="4">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Remove" Click="RemoveExclusion_Click" Tag="{Binding}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="16">
                        <TextBlock Text="System Utilities &amp; Storage Paths" Style="{StaticResource BodyStrongTextBlockStyle}" FontWeight="Bold" />

                        <Button x:Name="RefreshShellButton" Content="Force Refresh Windows Icon Cache" Click="RefreshShellButton_Click" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Icon Storage Path:" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="IcoPathTextBlock" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Profiles Storage Path:" FontWeight="SemiBold" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="ProfilesPathTextBlock" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
