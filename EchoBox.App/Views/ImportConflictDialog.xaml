<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="EchoBox.App.Views.ImportConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:EchoBox.App.Views"
    mc:Ignorable="d"
    Title="Matching Icons Found"
    PrimaryButtonText="Import Icons"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid Width="520" MaxHeight="500">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ConflictItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:ImportConflictItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16" HorizontalAlignment="Stretch">
                                    <!-- Current Icon -->
                                    <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="Current Icon" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <Border Background="{ThemeResource LayerOnAccentFillColorDefaultBrush}" CornerRadius="4" Padding="8" Width="72" Height="72" HorizontalAlignment="Center">
                                            <Image Width="56" Height="56" Source="{x:Bind ExistingIcon.FilePath, Mode=OneTime}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind ExistingIcon.Name, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </StackPanel>

                                    <!-- Arrow Icon -->
                                    <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,16,0,0" />

                                    <!-- New Icon -->
                                    <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="New Icon" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <Border Background="{ThemeResource LayerOnAccentFillColorDefaultBrush}" CornerRadius="4" Padding="8" Width="72" Height="72" HorizontalAlignment="Center">
                                            <Image Width="56" Height="56" Source="{x:Bind ImportedFilePath, Mode=OneTime}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind OriginalName, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    </StackPanel>
                                </Grid>

                                <!-- Name Field -->
                                <TextBox Header="Icon Name"
                                         Text="{x:Bind NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Enter icon name..."
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ContentDialog>
